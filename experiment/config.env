# Pinned, non-secret experiment configuration. Sourced by experiment/bin/*.
# Secrets live only in .local/experiment.env (see experiment/env.example).

# Capsule image
IMAGE_NAME=black-demo-capsule
NODE_BASE_IMAGE=node:22-bookworm-slim
CLAUDE_CODE_VERSION=2.1.314
RAILWAY_CLI_VERSION=5.71.0
PLAYWRIGHT_MCP_VERSION=0.0.83
ESBUILD_VERSION=0.28.2

# Frozen White toolchain: built from this commit of this local repository.
# Only the sanitized build output enters the image (see experiment/README.md).
WHITE_REPO=/Users/tab/personal/black-js
WHITE_COMMIT=6fb3fc2ef27e1f48b02aca6a42f8ef42f3f0055c

# Agent configuration
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Session lifecycle: how long the final screen stays visible after Claude's
# final response, and a hard ceiling on a run.
STOP_GRACE_SECONDS=20
MAX_RUN_SECONDS=21600

# Tools removed from the agent (sub-agents, background agents, publishing).
DISALLOWED_TOOLS=Agent,Task,Workflow,SendMessage,ListAgents,TaskStop,TeamCreate,TeamDelete,CronCreate,CronDelete,CronList,ScheduleWakeup,RemoteTrigger,PushNotification,Artifact,ArtifactComments,ArtifactData,EnterWorktree,ExitWorktree

# Railway target (project-scoped token is a secret; ids are not)
RAILWAY_PROJECT_ID=5e0a2e27-8129-4e73-b005-5e8dfc324979
RAILWAY_ENVIRONMENT_ID=17a2dc6a-5cb9-435f-91ca-c54a1fc13393
RAILWAY_SERVICE=black-demo
RAILWAY_SERVICE_ID=d2561f2e-cb79-48c6-82d0-41e32e116ac0
RAILWAY_PUBLIC_URL=https://black-demo-production.up.railway.app

# Hostnames made unresolvable inside the capsule (space-separated).
BLOCKED_HOSTS="polygon-pong-production.up.railway.app host.docker.internal host.orb.internal gateway.docker.internal"

# Docker network the capsule runs on (user-defined bridge, never host mode).
CAPSULE_NETWORK=black-demo-capsule-net
