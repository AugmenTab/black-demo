# Copy to .env (git-ignored) and fill in both values.
# Only these two variables are read and injected into the capsule.

# Claude Code subscription OAuth token: run `claude setup-token`.
# (API keys are not supported: the experiment must not use API billing.)
CLAUDE_CODE_OAUTH_TOKEN=

# Railway project token for project black-demo, environment production
# (Railway dashboard -> black-demo -> Settings -> Tokens).
RAILWAY_TOKEN=
